{
  "name": "velocityworkshareportal",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "preview": "vite preview",
    "deploy:functions": "npx firebase-tools deploy --only functions",
    "deploy:rules": "npx firebase-tools deploy --only firestore:rules",
    "deploy": "npm run build && npx firebase-tools deploy",
    "test": "tsc -p tsconfig.tests.json && node --import ./scripts/register-typescript.mjs --test tests/*.test.ts",
    "test:emulators": "npm --prefix functions run build && firebase emulators:exec --project demo-velocityworkshare --only firestore,functions,auth \"node --test tests/invitations.emulator.test.mjs\""
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "firebase": "^12.17.1",
    "framer-motion": "^13.1.0",
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^5.0.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "autoprefixer": "^10.5.4",
    "firebase-tools": "^15.30.2",
    "oxlint": "^1.75.0",
    "playwright": "^1.64.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
