rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email != null && request.auth.token.email.matches('(?i).*@velocity-swimming\\.com$'))
      );
    }

    match /admins/{uid} {
      allow read: if request.auth != null;
      allow write: if false;
    }

    match /_otp_codes/{docId} {
      allow read, write: if false;
    }

    match /families/{familyId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    match /postings/{postingId} {
      allow read: if true; // Guests can see jobs
      allow write: if isAdmin();
    }

    match /registrations/{registrationId} {
      allow read: if true; 
      allow create: if true; // Allow guest signups
      allow update, delete: if isAdmin() || request.auth != null;
    }
  }
}
