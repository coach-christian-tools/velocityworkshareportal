rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      // We will check if the user's UID is in an 'admins' collection
      return request.auth != null && exists(/databases/$(database)/documents/admins/$(request.auth.uid));
    }

    match /admins/{uid} {
      allow read, write: if false;
    }

    match /families/{familyId} {
      allow read: if request.auth != null;
      allow write: if isAdmin();
    }

    match /postings/{postingId} {
      allow read: if true; // Guests can see jobs
      allow write: if isAdmin();
    }

    match /registrations/{registrationId} {
      allow read: if true; 
      allow create: if true; // Allow guest signups
      allow update, delete: if isAdmin() || request.auth != null;
    }
  }
}
